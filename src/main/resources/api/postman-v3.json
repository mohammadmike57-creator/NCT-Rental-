    {
      "name": "7. OTA XML 2024A",
      "description": "Uses the channel's API key (X-Api-Key), not OAuth.",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ota/2024A/{{channel}}/OTA_Ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ota",
                "2024A",
                "{{channel}}",
                "OTA_Ping"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "<OTA_PingRQ xmlns=\"http://www.opentravel.org/OTA/2003/05\" EchoToken=\"1\" Version=\"2024.1\"><EchoData>Hello</EchoData></OTA_PingRQ>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "event": [
